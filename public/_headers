# Header untuk berkas statis yang dilayani langsung oleh Cloudflare Workers
# Static Assets (tanpa melewati Worker, jadi `headers()` di next.config.ts
# tidak berlaku). Halaman HTML tetap mendapat header dari next.config.ts.
# Format: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Nama berkas berisi hash build, aman di-cache selamanya.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
