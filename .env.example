# Salin ke .env.local lalu isi. Semua variabel opsional untuk development:
# kalau kosong, nilai cadangan di src/content/site.ts yang dipakai.

# Nomor WhatsApp format internasional, tanpa "+" dan tanpa spasi.
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# URL situs untuk canonical, sitemap, dan hreflang. Production: https://bungawisata.co.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kosong = email disembunyikan di seluruh situs, JSON-LD, dan PDF.
NEXT_PUBLIC_CONTACT_EMAIL=
